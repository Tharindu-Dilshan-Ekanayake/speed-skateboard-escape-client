# `npm run build:dev` - dev/playtest channel on Bloxity Legion.
# Connects straight to the dev backend (the matchmaker routes the prod channel).
VITE_GAME_SLUG=speed-skateboard-escape
VITE_GAME_ID=speed-skateboard-escape
