# Copy to `.env.local` for local development (it is git-ignored).

# Bloxity game slug (same as the Legion gameId).
VITE_GAME_SLUG=speed-skateboard-escape
VITE_GAME_ID=speed-skateboard-escape

# Bloxity endpoints. Leave these as-is unless you run the portal locally.
VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io

# Game backend (HTTP auth + direct WebSocket fallback).
VITE_SERVER_URL=http://localhost:2567

# Legion matchmaker. Leave empty locally to connect straight to VITE_SERVER_URL.
VITE_MATCHMAKER_URL=
